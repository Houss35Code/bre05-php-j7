<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageTitle }}</title>
    <style>
        body {
            font-family: sans-serif;
            background-color: #1a1a1a;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 50px;
        }
        h1 {
            margin-bottom: 40px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .team-grid {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 30px;
            max-width: 1000px;
        }
        .team-card {
            background-color: #2a2a2a;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            width: 180px;
            transition: transform 0.3s;
        }
        .team-card:hover {
            transform: translateY(-10px);
            background-color: #333;
        }
        .team-logo {
            width: 120px;
            height: 120px;
            object-fit: contain;
            margin-bottom: 15px;
        }
        .team-name {
            font-size: 1.1rem;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <h1>{{ pageTitle }}</h1>

    <div class="team-grid">
        {# On parcourt le tableau teams envoyé par l'index.php #}
        {% for team in teams %}
            <div class="team-card">
                {# Affichage du logo .png #}
                <img src="{{ team.logo }}" alt="Logo {{ team.name }}" class="team-logo">
                
                {# Affichage du nom de l'équipe #}
                <div class="team-name">{{ team.name }}</div>
            </div>
        {% endfor %}
    </div>

</body>
</html>